let VOICES=[];
function loadVoices(){if(!('speechSynthesis' in window))return;VOICES=speechSynthesis.getVoices();}
if('speechSynthesis' in window){loadVoices();speechSynthesis.onvoiceschanged=loadVoices;}
const FEMALE=/female|woman|zira|aria|jenny|samantha|hazel|susan|karen|moira|tessa|fiona|sonia|libby|natasha|ava|allison|google (us|uk) english/i;
const MALEX=/\bmale\b|david|mark|james|george|daniel|guy|ryan|alex\b/i;
function pickVoice(lang){
  const norm=v=>v.lang.toLowerCase().replace('_','-');
  const cand=VOICES.filter(v=>norm(v).startsWith(lang));
  if(lang==='km')return cand[0]||VOICES.find(v=>/khmer|ខ្មែរ/i.test(v.name))||null;
  return cand.find(v=>FEMALE.test(v.name))||cand.find(v=>!MALEX.test(v.name))||cand[0]||null;
}
function hasKhmer(){return !!pickVoice('km');}
let curAudio=null,gFail=false;
function speakGoogle(text,lang){
  return new Promise((res,rej)=>{
    const a=new Audio('https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl='+lang+'&q='+encodeURIComponent(text));
    a.playbackRate=.95;curAudio=a;a.onended=res;a.onerror=()=>rej(new Error('audio'));
    a.play().catch(rej);
  });
}
function speakOne(text,lang,tk){
  return new Promise(async res=>{
    bubble.textContent=text;
    speaking=true;
    const done=()=>{speaking=false;res();};
    if(lang==='km'&&!pickVoice('km')&&!gFail){
      try{await speakGoogle(text,'km');return done();}
      catch(e){gFail=true;}
    }
    if(!('speechSynthesis' in window)){setTimeout(done,Math.max(1800,text.length*90));return;}
    const u=new SpeechSynthesisUtterance(text);
    u.lang=lang==='km'?'km-KH':'en-US';
    const v=pickVoice(lang);if(v)u.voice=v;
    u.rate=.88;u.pitch=1.4;u.volume=.95;
    let finished=false;
    u.onend=()=>{if(!finished){finished=true;done();}};
    u.onerror=()=>{if(!finished){finished=true;setTimeout(done,Math.max(1800,text.length*90));}};
    speechSynthesis.speak(u);
    setTimeout(()=>{if(!finished&&!speechSynthesis.speaking){finished=true;done();}},Math.max(2500,text.length*130));
  });
}
async function say(item,tk){
  const m=modes[mi];
  if(m!=='en'){if(tk!==token)return;await speakOne(item.km,'km',tk);}
  if(m!=='km'){if(tk!==token)return;await speakOne(item.en,'en',tk);}
}
function stopAll(){
  token++;
  if(curAudio){curAudio.pause();curAudio=null;}
  if('speechSynthesis' in window)speechSynthesis.cancel();
  speaking=false;
}
async function idle(tk){
  let pool=[];
  while(tk===token){
    await sleep(2200);if(tk!==token)return;
    if(!pool.length)pool=TEASES.slice().sort(()=>Math.random()-.5);
    if(Math.random()<.5)play(['tilt','hairflick','nod','giggle'][Math.floor(Math.random()*4)]);
    await say(pool.pop(),tk);
  }
}
async function intro(){
  stopAll();const tk=token;paused=false;
  play('wave');
  await say(GREET,tk);if(tk!==token)return;
  idle(tk);
}
async function perform(name,line){
  if(!started){startRobot();return;}
  stopAll();const tk=token;paused=false;
  rb('rStop').textContent='🔇 ឈប់ / Stop';
  play(name);
  await say(line,tk);if(tk!==token)return;
  idle(tk);
}
async function react(part){
  if(!started){startRobot();return;}
  const R=REACT[part]||REACT.body;
  await perform(R.a,pickV(R.L,'r_'+part));
}

