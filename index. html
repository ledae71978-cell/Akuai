}
function upscale(){
  if(!img)return;const c=$('cv'),x=c.getContext('2d');
  const W=3840,s=W/img.width;c.width=W;c.height=Math.round(img.height*s);
  x.imageSmoothingEnabled=true;x.imageSmoothingQuality='high';
  let cur=img,cw=img.width,ch=img.height;
  while(cw*2<W){const t=document.createElement('canvas');t.width=cw*2;t.height=ch*2;const tx=t.getContext('2d');tx.imageSmoothingQuality='high';tx.drawImage(cur,0,0,t.width,t.height);cur=t;cw=t.width;ch=t.height}
  x.drawImage(cur,0,0,c.width,c.height);
  $('info').textContent=`${img.width}×${img.height} → ${c.width}×${c.height}`;
