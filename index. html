function rmBg(){
  if(!img)return;const c=$('cv'),x=c.getContext('2d',{willReadFrequently:true});
  const s=Math.min(1,1200/img.width);c.width=img.width*s;c.height=img.height*s;x.drawImage(img,0,0,c.width,c.height);
  const d=x.getImageData(0,0,c.width,c.height),a=d.data,t=+$('tol').value,w=c.width,h=c.height;
  const px=[[0,0],[w-1,0],[0,h-1],[w-1,h-1]].map(([i,j])=>{const k=(j*w+i)*4;return[a[k],a[k+1],a[k+2]]});
  const bg=[0,1,2].map(n=>px.reduce((s,p)=>s+p[n],0)/4);
  for(let i=0;i<a.length;i+=4){const dist=Math.hypot(a[i]-bg[0],a[i+1]-bg[1],a[i+2]-bg[2]);if(dist<t)a[i+3]=0;else if(dist<t*1.4)a[i+3]=255*(dist-t)/(t*.4)}
