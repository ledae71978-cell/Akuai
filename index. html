function chemParse(f){
  f=f.replace(/\s+/g,'').replace(/[\[{]/g,'(').replace(/[\]}]/g,')');if(!f)throw new Error('ទទេ');
  const tot={};
  f.split(/[·.]/).forEach(p=>{
    let mul=1;const m=p.match(/^(\d+)(.*)$/);if(m){mul=+m[1];p=m[2]}
    const st=[{}];let i=0;
    while(i<p.length){const c=p[i];
      if(c==='('){st.push({});i++}
      else if(c===')'){i++;let n='';while(/\d/.test(p[i]||''))n+=p[i++];if(st.length<2)throw new Error('វង់ក្រចកមិនត្រូវគ្នា');const top=st.pop(),k=+n||1;for(const e in top)st[st.length-1][e]=(st[st.length-1][e]||0)+top[e]*k}
      else if(/[A-Z]/.test(c)){let e=c;i++;while(/[a-z]/.test(p[i]||''))e+=p[i++];let n='';while(/\d/.test(p[i]||''))n+=p[i++];if(!(e in AM))throw new Error('មិនស្គាល់ធាតុ '+e);st[st.length-1][e]=(st[st.length-1][e]||0)+(+n||1)}
      else throw new Error('តួអក្សរមិនត្រឹមត្រូវ "'+c+'"');}
    if(st.length!==1)throw new Error('វង់ក្រចកមិនគ្រប់');
    for(const e in st[0])tot[e]=(tot[e]||0)+st[0][e]*mul;
  });
  return tot;
}
