    if(!c||!l.trim()||/^---+$/.test(l.trim()))return;
    const nm=l.match(/^\s*(?:notes?|កំណត់សម្គាល់)\s*[:：]\s*(.+)$/i);if(nm){c.notes+=(c.notes?' ':'')+nm[1];return}
