const esc=t=>String(t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function mathEval(src,x,deg){
  const R=v=>deg?v*Math.PI/180:v,B=v=>deg?v*180/Math.PI:v;
  const F={sin:v=>Math.sin(R(v)),cos:v=>Math.cos(R(v)),tan:v=>Math.tan(R(v)),asin:v=>B(Math.asin(v)),acos:v=>B(Math.acos(v)),atan:v=>B(Math.atan(v)),sqrt:Math.sqrt,log:Math.log10,ln:Math.log,exp:Math.exp,abs:Math.abs,floor:Math.floor,ceil:Math.ceil,round:Math.round};
  const toks=String(src).toLowerCase().replace(/×/g,'*').replace(/÷/g,'/').replace(/π/g,'pi').replace(/√/g,'sqrt').replace(/[−–]/g,'-').match(/\d+\.?\d*(?:e[+-]?\d+)?|\.\d+|[a-z]+|[+\-*/^()]|\S/g)||[];
  let out='',prev='',lastPow=false,neg=false;
  for(const t of toks){
    if((t==='-'||t==='+')&&(prev===''||prev==='o'||prev==='(')){
      if(prev==='o'&&lastPow){if(t==='-')neg=true;continue}
      if(t==='-')out+='(-1)*';
      prev='o';lastPow=false;continue;
    }
    let type,code;
    if(/^[\d.]/.test(t)){type='n';code=t}
    else if(t==='pi'){type='n';code='Math.PI'}
    else if(t==='e'){type='n';code='Math.E'}
    else if(t==='x'){type='n';code='x'}
    else if(F[t]){type='f';code='F.'+t}
    else if(t==='('){type='(';code='('}
    else if(t===')'){type=')';code=')'}
    else if('+-*/'.includes(t)){type='o';code=t}
    else if(t==='^'){type='o';code='**'}
    else throw new Error('មិនស្គាល់ "'+t+'"');
    if(neg){if(type!=='n')throw new Error('សូមប្រើវង់ក្រចកក្រោយ ^-');code='(-'+code+')';neg=false}
    if((prev==='n'||prev===')')&&(type==='n'||type==='f'||type==='('))out+='*';
    out+=code;prev=type;lastPow=(t==='^');
  }
  if(!out)throw new Error('ទទេ');
  return new Function('F','x','"use strict";return ('+out+')')(F,x);
}
