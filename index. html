  girl.add(M(new THREE.SphereGeometry(.1,12,12),ribbon,0,.38,.52,'body'));
  [-1,1].forEach(d=>{const w=M(new THREE.ConeGeometry(.12,.3,10),ribbon,d*.2,.38,.52,'body');w.rotation.z=d*Math.PI/2;girl.add(w);});
  girl.add(M(new THREE.CylinderGeometry(.55,1.0,.8,24),navy,0,-.95,0,'feet'));
  girl.add(M(new THREE.CylinderGeometry(.15,.15,.3,12),skin,0,.8,0,'body'));
  [-.26,.26].forEach(x=>{
    girl.add(M(new THREE.CylinderGeometry(.13,.12,.9,12),skin,x,-1.8,0,'feet'));
    girl.add(M(new THREE.CylinderGeometry(.14,.14,.35,12),white,x,-2.0,0,'feet'));
    girl.add(M(new THREE.BoxGeometry(.3,.15,.45),shoe,x,-2.35,.08,'feet'));
  });
  function arm(x){
    const g=new THREE.Group();g.position.set(x,.5,0);
    g.add(M(new THREE.CylinderGeometry(.14,.13,.8,12),white,0,-.4,0,'hand'));
    g.add(M(new THREE.CylinderGeometry(.1,.09,.6,12),skin,0,-1.0,0,'hand'));
    g.add(M(new THREE.SphereGeometry(.13,12,12),skin,0,-1.38,0,'hand'));
    girl.add(g);return g;
  }
  const armL=arm(-.72),armR=arm(.72);

  const head=new THREE.Group();head.position.y=1.9;girl.add(head);
  const hm=M(new THREE.SphereGeometry(1,32,32),skin,0,0,0,'head');hm.scale.set(1,.95,.92);head.add(hm);
  const back=M(new THREE.SphereGeometry(1.05,32,32),hair,0,-.05,-.18,'hair');back.scale.set(1.02,1,.9);head.add(back);
  const cap=M(new THREE.SphereGeometry(1.06,32,32,0,Math.PI*2,0,Math.PI*.36),hair,0,0,0,'head');cap.scale.set(1,.97,.95);head.add(cap);
  for(let i=-2;i<=2;i++){
    const b=M(new THREE.ConeGeometry(.2,.55,10),hair,i*.33,.62,.83-i*i*.07,'head');
    b.rotation.x=Math.PI-.5;b.rotation.z=i*.12;head.add(b);
  }
  [-1,1].forEach(d=>{const s=M(new THREE.ConeGeometry(.2,1.3,10),hair,d*.97,-.1,.2,'hair');s.rotation.x=Math.PI;head.add(s);});
  const ahoge=M(new THREE.ConeGeometry(.06,.5,8),hair,0,1.15,.1,'hair');ahoge.rotation.z=-.4;head.add(ahoge);

  const eyes=[],blushes=[];
  [-1,1].forEach(d=>{
    const e=new THREE.Mesh(new THREE.PlaneGeometry(.62,.72),new THREE.MeshBasicMaterial({map:eyeTexture(d<0),transparent:true}));
    e.position.set(d*.4,-.05,.86);e.rotation.y=d*.16;e.userData.part='face';head.add(e);eyes.push(e);
    const bl=new THREE.Mesh(new THREE.CircleGeometry(.16,20),new THREE.MeshBasicMaterial({color:0xff8fa3,transparent:true,opacity:.5}));
    bl.position.set(d*.58,-.35,.74);bl.rotation.y=d*.55;bl.userData.part='face';head.add(bl);blushes.push(bl);
  });
  const smile=M(new THREE.TorusGeometry(.12,.018,8,20,Math.PI),toon(0xc2455f),0,-.36,.86,'face');smile.rotation.z=Math.PI;head.add(smile);
  const mouth=M(new THREE.SphereGeometry(.11,16,16),toon(0x7a1f3a),0,-.42,.85,'face');mouth.scale.set(1,.6,.3);mouth.visible=false;head.add(mouth);

  const tails=[];
  [-1,1].forEach(d=>{
    const g=new THREE.Group();g.position.set(d*1.05,.55,-.2);
    g.add(M(new THREE.SphereGeometry(.15,12,12),ribbon,0,0,0,'hair'));
    g.add(M(new THREE.CylinderGeometry(.3,.03,2.1,14),hair,0,-1.05,0,'hair'));
    head.add(g);tails.push({g:g,d:d});
  });

  // click / tap on the character
  const ray=new THREE.Raycaster(),v2=new THREE.Vector2();
  renderer.domElement.addEventListener('pointerdown',e=>{
    const r=renderer.domElement.getBoundingClientRect();
    v2.set(((e.clientX-r.left)/r.width)*2-1,-((e.clientY-r.top)/r.height)*2+1);
    ray.setFromCamera(v2,camera);
    const hit=ray.intersectObjects(MODEL.root?[MODEL.root]:girl.children,true)[0];
    if(hit)react(MODEL.root?modelPart(hit):(hit.object.userData.part||'body'));
  });

  resize();
  if('ResizeObserver' in window)new ResizeObserver(resize).observe(stage);
  addEventListener('resize',resize);
  if('IntersectionObserver' in window)new IntersectionObserver(en=>{visible=en[0].isIntersecting;}).observe(stage);

  loadModel(girl,{amb:amb,dl:dl,pl:pl});
  const clock=new THREE.Clock();let blink=0,sy=0,tailAmp=.08,blushOp=.5;
  (function loop(){
    requestAnimationFrame(loop);
    if(!visible)return;
    const t=clock.getElapsedTime(),now=performance.now()/1000;
    let p=0,A=null;
    if(anim){p=(now-anim.t0)/DUR[anim.n];if(p>=1)anim=null;else A=anim.n;}
    if(!A&&!speaking&&Math.random()<.0015)play(['tilt','hairflick','stretch','nod','giggle'][Math.floor(Math.random()*5)]);
    const env=Math.sin(Math.PI*Math.min(p,1));
    const T={gy:0,gry:Math.sin(t*.6)*.08,grx:0,hz:Math.sin(t*.8)*.04,hx:0,aLz:-.15+Math.sin(t*1.5)*.04,aRz:.15+Math.sin(t*1.5+1)*.04,aLx:0,aRx:0,sq:1,bl:.5,tail:.08};
    let spinAdd=0;
    if(speaking){T.hx+=Math.sin(t*5)*.03;T.gy+=Math.abs(Math.sin(t*5))*.03;T.aRz+=Math.sin(t*3)*.08;}
    switch(A){
      case 'wave':T.aRz=2.5+Math.sin(t*10)*.35;T.hz=.12;break;
      case 'dance':T.gry=Math.sin(t*4)*.6;T.gy=Math.abs(Math.sin(t*6))*.3*Math.min(1,env*3);T.aLz=-(1.6+Math.sin(t*6)*.5);T.aRz=1.6+Math.cos(t*6)*.5;T.hz=Math.sin(t*4)*.15;T.tail=.35;break;
      case 'bow':T.grx=.45*env;T.hx=.3*env;T.aLz=-.1;T.aRz=.1;break;
      case 'shy':{const k=Math.min(1,env*2);T.aLx=-1.7*k;T.aRx=-1.7*k;T.aLz=.5*k-.15*(1-k);T.aRz=-.5*k+.15*(1-k);T.hz=.15;T.hx=.12;T.bl=1;T.sq=.6;break;}
      case 'jump':T.gy=Math.sin(Math.PI*p)*1.0;T.aLz=-1.0*env;T.aRz=1.0*env;break;
      case 'spin':{const e=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;spinAdd=e*Math.PI*2;T.gy=Math.sin(Math.PI*p)*.3;T.aLz=-.8*env;T.aRz=.8*env;T.tail=.3;break;}
      case 'giggle':T.hz=Math.sin(t*18)*.12;T.sq=.5;T.gy=Math.abs(Math.sin(t*14))*.08;T.bl=.8;break;
      case 'hairflick':T.tail=.35+Math.sin(t*10)*.1;T.hz=.1*env;break;
      case 'stretch':T.aLz=-2.8*env-.15*(1-env);T.aRz=2.8*env+.15*(1-env);T.hx=-.15*env;break;
      case 'nod':T.hx=Math.sin(t*9)*.15*env;break;
      case 'tilt':T.hz=.25*env;T.sq=.7;break;
    }
    girl.position.y=L(girl.position.y,.6+Math.sin(t*1.5)*.08+T.gy,.25);
    sy=L(sy,T.gry,.15);girl.rotation.y=sy+spinAdd;
    girl.rotation.x=L(girl.rotation.x,T.grx,.2);
    head.rotation.y+=((mx*.5)-head.rotation.y)*.08;
    head.rotation.x=L(head.rotation.x,my*.3+T.hx,.1);
    head.rotation.z=L(head.rotation.z,T.hz,.2);
    armL.rotation.z=L(armL.rotation.z,T.aLz,.2);armR.rotation.z=L(armR.rotation.z,T.aRz,.2);
    armL.rotation.x=L(armL.rotation.x,T.aLx,.2);armR.rotation.x=L(armR.rotation.x,T.aRx,.2);
    tailAmp=L(tailAmp,T.tail,.1);
    tails.forEach(o=>{o.g.rotation.z=o.d*(.2+Math.sin(t*(A==='hairflick'||A==='dance'?8:2)+o.d)*tailAmp);});
    blushOp=L(blushOp,T.bl,.1);blushes.forEach(b=>b.material.opacity=blushOp);
    if(Math.random()<.008)blink=.15;
    const es=blink>0?.08:T.sq;blink=Math.max(0,blink-.016);eyes.forEach(e=>{e.scale.y=L(e.scale.y,es,.5);});
    if(speaking){const o=Math.abs(Math.sin(t*14));smile.visible=false;mouth.visible=true;mouth.scale.set(1-o*.2,.4+o*1.0,.3);}
    else{smile.visible=true;mouth.visible=false;}
    if(MODEL.ready)poseModel(t,T,A,spinAdd,sy);
    renderer.render(scene,camera);
  })();
}
/* 3D is deliberately loaded only after the user opens it. This keeps phones fast. */
})();
</script>
</body>
</html>
